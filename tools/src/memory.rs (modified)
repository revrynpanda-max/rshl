//! Memory Module – 7‑region Hebbian Synaptic Layer.
//!
//! Original RSHL core, now integrated with the ClaimStore for higher‑level
//! epistemic memory. The existing functionality remains unchanged; the
//! `EpistemicMemory` struct provides a bridge to `claim_store::ClaimStore`.

use crate::claim_store::{Claim, ClaimStore, EmotionalValence};
use crate::lattice::SparseVec;
use crate::user_isolation::{hash_user_id, claim_belongs_to_user};
use std::sync::Arc;
use tokio::sync::RwLock;

/// A lightweight struct wrapping the ClaimStore and providing RSHL‑specific
/// operations (encoding claims into vectors, similarity search, etc.).
pub struct EpistemicMemory {
    pub store: Arc<ClaimStore>,
}

impl EpistemicMemory {
    pub fn new(store: Arc<ClaimStore>) -> Self {
        Self { store }
    }

    /// Encode a claim into an RSHL vector (ternary). Uses the subject, object,
    /// and emotional weights to seed the hashing.
    pub fn encode_claim(&self, claim: &Claim) -> SparseVec {
        // Import encode from RSHL core
        use crate::lattice::encode as rshl_encode;
        let text = format!("{} {} {} {} {} {}",
            claim.subject,
            claim.relation,
            claim.object,
            claim.emotion.curiosity,
            claim.emotion.conflict,
            claim.emotion.resonance,
        );
        rshl_encode(&text)
    }

    /// Insert a claim with automatic emotional weighting and user isolation.
    pub async fn insert_claim(&self, mut claim: Claim) -> String {
        // Ensure user_hash is set
        if claim.user_hash.is_empty() {
            // If no user provided, it becomes universal Tier 4
            claim.user_hash = String::new();
        }
        // Set initial emotional weight if default
        if claim.emotion == EmotionalValence::default() {
            claim.emotion = crate::emotional_weight::initial_emotional_weight(&claim);
        }
        // Insert into store
        let id = self.store.insert(claim).await;
        id
    }

    /// Retrieve a claim by ID, respecting user isolation.
    pub async fn get_claim(&self, id: &str, user_id: &str) -> Option<Claim> {
        let user_hash = hash_user_id(user_id);
        let claim = self.store.get_by_id(id).await?;
        if claim_belongs_to_user(&claim.user_hash, &user_hash) {
            Some(claim)
        } else {
            None
        }
    }

    /// Query claims by subject, isolated to user.
    pub async fn query_user_claims(&self, subject: &str, user_id: &str) -> Vec<Claim> {
        let user_hash = hash_user_id(user_id);
        self.store.query(subject, &user_hash).await
    }

    /// Run the Dream Cycle (consolidation) on the entire store.
    pub async fn dream_cycle(&self) {
        self.store.dream_cycle().await;
    }
}

